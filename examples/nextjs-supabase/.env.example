# Supabase: Project > Connect > Transaction pooler (port 6543). The app uses this.
DATABASE_URL=postgres://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Supabase: Project > Connect > Direct connection, or Session pooler (port 5432). Migrations use this.
DIRECT_DATABASE_URL=postgres://postgres:[password]@db.[project-ref].supabase.co:5432/postgres

# Any other PostgreSQL works too, for example a local one:
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/postgres
